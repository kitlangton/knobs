{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "knobs": ["./src/index.ts"],
      "knobs/react": ["./src/react/index.ts"],
      "knobs/solid": ["./src/solid/index.ts"],
      "knobs/panel": ["./src/panel/index.ts"]
    }
  },
  "include": ["src", "tests", "examples", "scripts", "*.ts"]
}
