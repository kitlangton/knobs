{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "knobs": ["./src/index.ts"],
      "knobs/react": ["./src/react/index.ts"],
      "knobs/solid": ["./src/solid/index.ts"],
      "knobs/panel": ["./src/panel/index.ts"],
      "knobs/themes": ["./src/themes/index.ts"],
      "knobs/ui": ["./src/ui/index.ts"],
      "knobs/ui/react": ["./src/ui/react.tsx"],
      "knobs/ui/solid": ["./src/ui/solid.ts"],
      "knobs/review": ["./src/review/index.ts"],
      "knobs/review/react": ["./src/review/react.tsx"],
      "knobs/review/solid": ["./src/review/solid.ts"]
    }
  },
  "include": ["src", "tests", "examples", "scripts", "site", "*.ts"]
}
