{
  "name": "@kitlangton/knobs",
  "version": "0.4.0-next.19",
  "description": "Per-component tuning controls. Explore in development, ship constants.",
  "type": "module",
  "license": "MIT",
  "author": "Kit Langton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitlangton/knobs.git"
  },
  "homepage": "https://knobs.kitlangton.com",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/types/solid/index.d.ts",
      "default": "./dist/solid.js"
    },
    "./panel": {
      "types": "./dist/types/panel/index.d.ts",
      "default": "./dist/panel.js"
    },
    "./themes": {
      "types": "./dist/types/themes/index.d.ts",
      "default": "./dist/themes.js"
    },
    "./ui": {
      "types": "./dist/types/ui/index.d.ts",
      "default": "./dist/ui.js"
    },
    "./ui/react": {
      "types": "./dist/types/ui/react.d.ts",
      "default": "./dist/ui-react.js"
    },
    "./ui/solid": {
      "types": "./dist/types/ui/solid.d.ts",
      "default": "./dist/ui-solid.js"
    },
    "./review": {
      "types": "./dist/types/review/index.d.ts",
      "default": "./dist/review.js"
    },
    "./review/react": {
      "types": "./dist/types/review/react.d.ts",
      "default": "./dist/review-react.js"
    },
    "./review/solid": {
      "types": "./dist/types/review/solid.d.ts",
      "default": "./dist/review-solid.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "bun run build && bun run example:build && playwright test",
    "format": "biome format --write .",
    "example": "vite --config examples/vite.config.ts",
    "example:build": "vite build --config examples/vite.config.ts",
    "site": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "site:deploy": "bun run site:build && bunx wrangler@latest deploy",
    "test:site": "playwright test --config playwright.site.config.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "@pierre/diffs": "^1.5.2",
    "react": ">=18",
    "solid-js": ">=1.8"
  },
  "peerDependenciesMeta": {
    "@pierre/diffs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@pierre/diffs": "^1.5.2",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@webgpu/types": "^0.1.74",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "^0.4.1"
  }
}
