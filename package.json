{
  "name": "knobs",
  "version": "0.1.0",
  "description": "Per-component tuning controls. Explore in development, ship constants.",
  "type": "module",
  "license": "MIT",
  "author": "Kit Langton",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/types/solid/index.d.ts",
      "default": "./dist/solid.js"
    },
    "./panel": {
      "types": "./dist/types/panel/index.d.ts",
      "default": "./dist/panel.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "bun run build && bun run example:build && playwright test",
    "format": "biome format --write .",
    "example": "vite --config examples/vite.config.ts",
    "example:build": "vite build --config examples/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "^0.4.1"
  }
}
